# ContextRead settings. `contextread` reads this file from the folder you run it in.
# Never commit it: it holds secrets.

# ---- Required: an OpenAI-compatible model endpoint ----
OPENAI_API_KEY=
# leave empty for api.openai.com, or set your gateway's URL
OPENAI_BASE_URL=
# hard cap on model spend (USD); calls stop once it is reached
LLM_BUDGET_USD=10

# ---- Models ----
# chat answers (low reasoning effort for reasoning models)
# CHAT_MODEL=gpt-6-luna
# section summaries and the document description
# LLM_DEFAULT_MODEL=gpt-4o-mini
# scanned / image pages ("off" = Tesseract only)
# OCR_VLM_MODEL=gpt-6-luna
# splits sections over 5 pages into their headings or 5-page parts ("off" = layout-only tree)
# TREE_EXPAND_MODEL=gpt-6-luna
# model calls are cut off and retried (twice) after this many seconds
# LLM_TIMEOUT_SECONDS=90
# identical requests are answered from a local cache (~/.cache/contextread/llm)
# LLM_CACHE=true

# ---- Postgres (docker-compose.yml starts one on port 5434) ----
APP_PG_PASSWORD=__PG_PASSWORD__
APP_PG_DSN=postgresql://contextread:${APP_PG_PASSWORD}@127.0.0.1:5434/contextread

# ---- S3-compatible object storage (docker-compose.yml starts one on port 9100) ----
S3_ENDPOINT_URL=http://127.0.0.1:9100
S3_ACCESS_KEY_ID=contextread
S3_SECRET_ACCESS_KEY=__S3_SECRET__
S3_BUCKET=contextread-documents
S3_REGION=us-east-1

# ---- API server ----
# token for internal (service-to-service) endpoints
INTERNAL_API_TOKEN=__INTERNAL_TOKEN__
# PUBLIC_API_URL=http://127.0.0.1:8000

# ---- Optional: per-user plan limits (0 = no limit) ----
# PAGE_LIMIT=0
# CHAT_LIMIT=0
