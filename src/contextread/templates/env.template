# ContextRead settings. `contextread` reads this file from the folder you run it in.
# Never commit it: it holds secrets.

# ---- Required: an OpenAI-compatible model endpoint ----
OPENAI_API_KEY=
# leave empty for api.openai.com, or set your gateway's URL
OPENAI_BASE_URL=
# hard cap on model spend (USD); calls stop once it is reached
LLM_BUDGET_USD=10

# ---- Models ----
# chat answers (low reasoning effort for reasoning models)
# CHAT_MODEL=gpt-6-luna
# section summaries and the document description
# LLM_DEFAULT_MODEL=gpt-4o-mini
# scanned / image pages ("off" = Tesseract only)
# OCR_VLM_MODEL=gpt-6-luna
# splits sections over 5 pages into their headings or 5-page parts ("off" = layout-only tree)
# TREE_EXPAND_MODEL=gpt-6-luna
# model calls are cut off and retried (twice) after this many seconds
# LLM_TIMEOUT_SECONDS=90
# identical requests are answered from a local cache (~/.cache/contextread/llm)
# LLM_CACHE=true
# model names starting with one of these (comma-separated) are reasoning models: they get
# reasoning_effort instead of temperature (e.g. gpt-6,o3,o4,gpt-5)
# REASONING_MODELS=gpt-6

# ---- Tuning (defaults measured on legal filings and credit agreements) ----
# Indexing (applies to documents indexed after a change; re-index to apply it to older ones)
# a section over this many pages is checked for headings the layout missed ...
# SECTION_HEADINGS_PAGES=5
# ... reading this many pages per call
# HEADINGS_WINDOW_PAGES=10
# a section still over this many pages and characters, with no headings in it, ...
# SECTION_SPLIT_PAGES=10
# SECTION_SPLIT_CHARS=20000
# ... is split into parts of this many pages, each titled by what it covers
# SPLIT_PART_PAGES=5
# how much of a section its summary is written from (characters)
# SUMMARY_INPUT_CHARS=8000
# a page goes to the vision model when one image covers this share of it (a scan) ...
# SCAN_IMAGE_SHARE=0.7
# ... or when this share of its ink has no text behind it (text drawn as outlines)
# SCAN_INK_WITHOUT_TEXT=0.25
# Chat
# reasoning effort of a reasoning chat model (low | medium | high)
# CHAT_EFFORT=low
# model turns per question (the last one must answer)
# CHAT_MAX_TURNS=8
# the most of a document's tree the model sees at once (characters, ~100k tokens); a larger tree keeps
# every title and page range and shortens summaries
# CHAT_STRUCTURE_CHARS=400000
# pages one read returns, and the characters they may hold
# CHAT_PAGES_PER_READ=10
# CHAT_READ_CHARS=80000
# CHAT_ANSWER_MAX_TOKENS=1500

# ---- Postgres (docker-compose.yml starts one on PG_PORT) ----
PG_PORT=5434
APP_PG_PASSWORD=__PG_PASSWORD__
APP_PG_DSN=postgresql://contextread:${APP_PG_PASSWORD}@127.0.0.1:${PG_PORT}/contextread

# ---- S3-compatible object storage (docker-compose.yml starts one on S3_PORT) ----
S3_PORT=9100
S3_ENDPOINT_URL=http://127.0.0.1:${S3_PORT}
S3_ACCESS_KEY_ID=contextread
S3_SECRET_ACCESS_KEY=__S3_SECRET__
S3_BUCKET=contextread-documents
S3_REGION=us-east-1

# ---- API server ----
# token for internal (service-to-service) endpoints
INTERNAL_API_TOKEN=__INTERNAL_TOKEN__
# PUBLIC_API_URL=http://127.0.0.1:8000

# ---- Optional: per-user plan limits (0 = no limit) ----
# PAGE_LIMIT=0
# CHAT_LIMIT=0
